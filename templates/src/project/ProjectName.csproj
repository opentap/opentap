<Project Sdk="Microsoft.NET.Sdk" ToolsVersion="Current">
  <PropertyGroup>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <TargetFramework>net9</TargetFramework>
  </PropertyGroup>
    
  <PropertyGroup>
    <OpenTapPackageDefinitionPath>package.xml</OpenTapPackageDefinitionPath>
    <CreateOpenTapPackage>false</CreateOpenTapPackage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <CreateOpenTapPackage>true</CreateOpenTapPackage>
  </PropertyGroup>

  <!-- Fall back to the Git version when OpenTapVersion is not provided by a
       Directory.Build.props (e.g. when this project is not part of a solution
       created from the OpenTAP solution template). Can be removed if
       OpenTapVersion is always inherited from Directory.Build.props. -->
  <PropertyGroup Condition="'$(OpenTapVersion)' == ''">
    <OpenTapVersion>$(GitVersion)</OpenTapVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTAP" Version="$(OpenTapVersion)" />
    <OpenTapPackageReference Include="Editor" version="9"/>
  </ItemGroup>

</Project>
