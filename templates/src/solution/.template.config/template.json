{
  "$schema": "http://json.schemastore.org/template",
  "author": "opentap.io",
  "classifications": [ "OpenTAP", "Test Automation", "Solution" ],
  "identity": "OpenTAP.Solution",
  "name": "OpenTAP Solution",
  "shortName": "opentap-solution",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "ProjectName",
  "defaultName": "MyOpenTAPPlugin",
  "preferNameDirectory": true,
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        ".template.config/**/*"
      ],
      "rename": {
        "gitversion": ".gitversion"
      },
      "modifiers": [
        { "condition": "(!CliAction)", "exclude": [ "**/*CliAction.cs" ] },
        { "condition": "(!ComponentSettings)", "exclude": [ "**/*ComponentSettings.cs" ] },
        { "condition": "(!DUT)", "exclude": [ "**/*DUT.cs" ] },
        { "condition": "(!Instrument)", "exclude": [ "**/*Instrument.cs" ] },
        { "condition": "(!ResultListener)", "exclude": [ "**/*ResultListener.cs" ] },
        { "condition": "(!TestStep)", "exclude": [ "**/*TestStep.cs" ] },
        { "condition": "(!CI)", "exclude": [ ".github/**" ] },
        {
          "condition": "(TUIRegex)",
          "rename": {
            "TUI.LaunchSettings.json": "launchSettings.json",
            "TUI.Launch.json": "launch.json"
          }
        },
        {
          "condition": "(!TUIRegex)",
          "exclude": [ "**/TUI.*" ]
        },
        {
          "condition": "(EditorRegex)",
          "rename": {
            "Editor.LaunchSettings.json": "launchSettings.json",
            "Editor.Launch.json": "launch.json"
          }
        },
        {
          "condition": "(!EditorRegex)",
          "exclude": [ "**/Editor.*" ]
        }
      ]
    }
  ],
  "symbols": {
    "HostIdentifier": {
      "type": "bind",
      "binding": "HostIdentifier"
    },
    "CI": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "true",
      "displayName": "Include CI/CD",
      "description": "Include a GitHub Actions workflow for building and publishing packages."
    },
    "TestStep": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "true",
      "displayName": "Include TestStep",
      "description": "Include a TestStep in the plugin."
    },
    "DUT": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "displayName": "Include DUT",
      "description": "Include a DUT in the plugin."
    },
    "Instrument": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "displayName": "Include Instrument",
      "description": "Include an Instrument in the plugin."
    },
    "ComponentSettings": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "displayName": "Include ComponentSettings",
      "description": "Include a ComponentSettings in the plugin."
    },
    "ResultListener": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "displayName": "Include ResultListener",
      "description": "Include a ResultListener in the plugin."
    },
    "CliAction": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "displayName": "Include CliAction",
      "description": "Include a CliAction in the plugin."
    },
    "Editor": {
      "type": "parameter",
      "datatype": "choice",
      "replaces": "TapEditor",
      "defaultValue": "Editor",
      "description": "The default editor to debug with.",
      "choices": [
        {
          "choice": "TUI",
          "displayName": "OpenTAP TUI",
          "description": "Set TUI as the debugging editor."
        },
        {
          "choice": "Editor",
          "displayName": "Keysight Test Automation",
          "description": "Set Keysight Test Automation as the debugging editor."
        }
      ]
    },
    "TUIRegex": {
      "type": "generated",
      "generator": "regexMatch",
      "dataType": "bool",
      "parameters": {
        "source": "Editor",
        "pattern": "TUI"
      }
    },
    "EditorRegex": {
      "type": "generated",
      "generator": "regexMatch",
      "dataType": "bool",
      "parameters": {
        "source": "Editor",
        "pattern": "Editor"
      }
    }
  },
  "postActions": [
    {
      "condition": "(HostIdentifier == 'dotnetcli' || HostIdentifier == 'dotnetcli-preview')",
      "description": "Set up a git repository so $(GitVersion) versioning works.",
      "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
      "continueOnError": true,
      "manualInstructions": [
        { "text": "Run 'git init -b main' (and commit) to enable $(GitVersion) versioning. See README.md." }
      ]
    }
  ]
}
