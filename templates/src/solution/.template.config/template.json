{
  "$schema": "http://json.schemastore.org/template",
  "author": "opentap.io",
  "classifications": [ "OpenTAP", "Test Automation", "Solution" ],
  "identity": "OpenTAP.Solution",
  "name": "OpenTAP Solution",
  "shortName": "opentap-solution",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "MyPlugin",
  "defaultName": "MyOpenTAPPlugin",
  "preferNameDirectory": true,
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        ".template.config/**/*"
      ],
      "rename": {
        "gitversion": ".gitversion"
      },
      "modifiers": [
        { "condition": "(!CliAction)", "exclude": [ "**/*CliAction.cs" ] },
        { "condition": "(!ComponentSettings)", "exclude": [ "**/*ComponentSettings.cs" ] },
        { "condition": "(!DUT)", "exclude": [ "**/*DUT.cs" ] },
        { "condition": "(!Instrument)", "exclude": [ "**/*Instrument.cs" ] },
        { "condition": "(!ResultListener)", "exclude": [ "**/*ResultListener.cs" ] },
        { "condition": "(!TestStep)", "exclude": [ "**/*TestStep.cs" ] },
        { "condition": "(!CI)", "exclude": [ ".github/**" ] }
      ]
    }
  ],
  "symbols": {
    "Namespace": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "identity",
      "replaces": "ProjectName"
    },
    "CI": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "true",
      "displayName": "Include CI/CD",
      "description": "Include a GitHub Actions workflow for building and publishing packages."
    },
    "TestStep": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "true",
      "displayName": "Include TestStep",
      "description": "Include a TestStep in the plugin."
    },
    "DUT": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "displayName": "Include DUT",
      "description": "Include a DUT in the plugin."
    },
    "Instrument": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "displayName": "Include Instrument",
      "description": "Include an Instrument in the plugin."
    },
    "ComponentSettings": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "displayName": "Include ComponentSettings",
      "description": "Include a ComponentSettings in the plugin."
    },
    "ResultListener": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "displayName": "Include ResultListener",
      "description": "Include a ResultListener in the plugin."
    },
    "CliAction": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "displayName": "Include CliAction",
      "description": "Include a CliAction in the plugin."
    }
  },
  "postActions": [
    {
      "description": "Set up a git repository so $(GitVersion) versioning works.",
      "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
      "continueOnError": true,
      "manualInstructions": [
        { "text": "Run 'git init -b main' (and commit) to enable $(GitVersion) versioning. See README.md." }
      ]
    }
  ]
}
