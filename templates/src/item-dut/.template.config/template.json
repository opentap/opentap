{
  "$schema": "http://json.schemastore.org/template",
  "author": "opentap.io",
  "classifications": [ "OpenTAP", "Test Automation" ],
  "identity": "OpenTAP.Item.DUT",
  "name": "OpenTAP DUT",
  "shortName": "opentap-dut",
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "sourceName": "MyDUT",
  "preferNameDirectory": false,
  "primaryOutputs": [
    { "path": "MyDUT.cs" }
  ],
  "symbols": {
    "Namespace": {
      "type": "parameter",
      "dataType": "string",
      "defaultValue": "MyNamespace",
      "replaces": "ProjectName",
      "displayName": "Namespace",
      "description": "The namespace for the created DUT."
    }
  }
}
