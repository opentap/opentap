{
  "$schema": "http://json.schemastore.org/template",
  "author": "opentap.io",
  "classifications": [ "Test Automation", "OpenTAP" ],
  "identity": "OpenTAP.Item.CliAction",
  "name": "OpenTAP Cli Action",
  "shortName": "opentap-cliaction",
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "sourceName": "MyCliAction",
  "preferNameDirectory": false,
  "primaryOutputs": [
    { "path": "MyCliAction.cs" }
  ],
  "symbols": {
    "Namespace": {
      "type": "parameter",
      "dataType": "string",
      "defaultValue": "MyNamespace",
      "replaces": "ProjectName",
      "displayName": "Namespace",
      "description": "The namespace for the created CliAction."
    }
  }
}
