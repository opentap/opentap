{
  "$schema": "http://json.schemastore.org/template",
  "author": "opentap.io",
  "classifications": [ "Test Automation", "OpenTAP" ],
  "identity": "OpenTAP.Item.TestStep",
  "name": "OpenTAP Test Step",
  "shortName": "opentap-teststep",
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "sourceName": "MyTestStep",
  "preferNameDirectory": false,
  "primaryOutputs": [
    { "path": "MyTestStep.cs" }
  ],
  "symbols": {
    "Namespace": {
      "type": "parameter",
      "dataType": "string",
      "defaultValue": "MyNamespace",
      "replaces": "ProjectName",
      "displayName": "Namespace",
      "description": "The namespace for the created TestStep."
    }
  }
}
