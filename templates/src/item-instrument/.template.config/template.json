{
  "$schema": "http://json.schemastore.org/template",
  "author": "opentap.io",
  "classifications": [ "OpenTAP", "Test Automation" ],
  "identity": "OpenTAP.Item.Instrument",
  "name": "OpenTAP Instrument",
  "shortName": "opentap-instrument",
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "sourceName": "MyInstrument",
  "preferNameDirectory": false,
  "primaryOutputs": [
    { "path": "MyInstrument.cs" }
  ],
  "symbols": {
    "Namespace": {
      "type": "parameter",
      "dataType": "string",
      "defaultValue": "MyNamespace",
      "replaces": "ProjectName",
      "displayName": "Namespace",
      "description": "The namespace for the created Instrument."
    }
  }
}
