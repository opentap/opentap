<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageVersion>$(GitVersion)</PackageVersion>
    <PackageId>OpenTap.Templates</PackageId>
    <Title>OpenTap Templates</Title>
    <Authors>OpenTap.io</Authors>
    <Description>Templates to use when developing OpenTap plugins</Description>
    <PackageTags>dotnet-new;templates;opentap</PackageTags>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://opentap.io</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/opentap/opentap.git</RepositoryUrl>

    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <!-- this disables a bogus warning in 'dotnet pack' which is supposed to be solved by using dotnet pack: 
    https://learn.microsoft.com/en-us/nuget/reference/errors-and-warnings/nu5128 
        CS2008 is a warning about no source files, which is intentional
    -->
    <NoWarn>$(NoWarn);NU5128;CS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Include all template content except the shared folder, which holds
         canonical source files that are fanned out into individual templates below. -->
    <Content Include="src\**\*" Exclude="src\shared\**\*" PackagePath="content" />
    <Compile Remove="**\*" />
    <None Include="..\LICENSE.txt" Pack="true" PackagePath="licenses\LICENSE.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared source files fanned out into each template that uses them, so the
         canonical file is only stored once in the repository. Each plugin type is
         used by the project template, its standalone item template, and the solution template. -->
    <Content Include="src\shared\MyTestStep.cs" PackagePath="content\project\MyTestStep.cs" />
    <Content Include="src\shared\MyTestStep.cs" PackagePath="content\item-teststep\MyTestStep.cs" />
    <Content Include="src\shared\MyTestStep.cs" PackagePath="content\solution\ProjectName\MyTestStep.cs" />

    <Content Include="src\shared\MyDUT.cs" PackagePath="content\project\MyDUT.cs" />
    <Content Include="src\shared\MyDUT.cs" PackagePath="content\item-dut\MyDUT.cs" />
    <Content Include="src\shared\MyDUT.cs" PackagePath="content\solution\ProjectName\MyDUT.cs" />

    <Content Include="src\shared\MyInstrument.cs" PackagePath="content\project\MyInstrument.cs" />
    <Content Include="src\shared\MyInstrument.cs" PackagePath="content\item-instrument\MyInstrument.cs" />
    <Content Include="src\shared\MyInstrument.cs" PackagePath="content\solution\ProjectName\MyInstrument.cs" />

    <Content Include="src\shared\MyResultListener.cs" PackagePath="content\project\MyResultListener.cs" />
    <Content Include="src\shared\MyResultListener.cs" PackagePath="content\item-resultlistener\MyResultListener.cs" />
    <Content Include="src\shared\MyResultListener.cs" PackagePath="content\solution\ProjectName\MyResultListener.cs" />

    <Content Include="src\shared\MyComponentSettings.cs" PackagePath="content\project\MyComponentSettings.cs" />
    <Content Include="src\shared\MyComponentSettings.cs" PackagePath="content\item-componentsettings\MyComponentSettings.cs" />
    <Content Include="src\shared\MyComponentSettings.cs" PackagePath="content\solution\ProjectName\MyComponentSettings.cs" />

    <Content Include="src\shared\MyCliAction.cs" PackagePath="content\project\MyCliAction.cs" />
    <Content Include="src\shared\MyCliAction.cs" PackagePath="content\item-cliaction\MyCliAction.cs" />
    <Content Include="src\shared\MyCliAction.cs" PackagePath="content\solution\ProjectName\MyCliAction.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared icon fanned out into each template's config, so the image is only
         stored once in the repository (in src\shared). -->
    <Content Include="src\shared\OpenTAP.png" PackagePath="content\project\.template.config\OpenTAP.png" />
    <Content Include="src\shared\OpenTAP.png" PackagePath="content\item-teststep\.template.config\OpenTAP.png" />
    <Content Include="src\shared\OpenTAP.png" PackagePath="content\item-dut\.template.config\OpenTAP.png" />
    <Content Include="src\shared\OpenTAP.png" PackagePath="content\item-instrument\.template.config\OpenTAP.png" />
    <Content Include="src\shared\OpenTAP.png" PackagePath="content\item-resultlistener\.template.config\OpenTAP.png" />
    <Content Include="src\shared\OpenTAP.png" PackagePath="content\item-componentsettings\.template.config\OpenTAP.png" />
    <Content Include="src\shared\OpenTAP.png" PackagePath="content\item-cliaction\.template.config\OpenTAP.png" />
    <Content Include="src\shared\OpenTAP.png" PackagePath="content\solution\.template.config\OpenTAP.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared debug/launch files fanned out into the project and solution
         templates, so each file is only stored once in the repository (in src\shared). -->
    <Content Include="src\shared\vscode\tasks.json" PackagePath="content\project\.vscode\tasks.json" />
    <Content Include="src\shared\vscode\tasks.json" PackagePath="content\solution\ProjectName\.vscode\tasks.json" />

    <Content Include="src\shared\vscode\Editor.Launch.json" PackagePath="content\project\.vscode\Editor.Launch.json" />
    <Content Include="src\shared\vscode\Editor.Launch.json" PackagePath="content\solution\ProjectName\.vscode\Editor.Launch.json" />

    <Content Include="src\shared\vscode\TUI.Launch.json" PackagePath="content\project\.vscode\TUI.Launch.json" />
    <Content Include="src\shared\vscode\TUI.Launch.json" PackagePath="content\solution\ProjectName\.vscode\TUI.Launch.json" />

    <Content Include="src\shared\Properties\Editor.LaunchSettings.json" PackagePath="content\project\Properties\Editor.LaunchSettings.json" />
    <Content Include="src\shared\Properties\Editor.LaunchSettings.json" PackagePath="content\solution\ProjectName\Properties\Editor.LaunchSettings.json" />

    <Content Include="src\shared\Properties\TUI.LaunchSettings.json" PackagePath="content\project\Properties\TUI.LaunchSettings.json" />
    <Content Include="src\shared\Properties\TUI.LaunchSettings.json" PackagePath="content\solution\ProjectName\Properties\TUI.LaunchSettings.json" />
  </ItemGroup>

</Project>
